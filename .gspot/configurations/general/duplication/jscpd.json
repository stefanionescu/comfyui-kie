{
    "mode": "strict",
    "minLines": 8,
    "minTokens": 40,
    "absolute": true,
    "gitignore": true,
    "ignorePattern": [
        "import\\s[^;]*?from\\s*['\"][^'\"]+['\"]\\s*;"
    ],
    "ignore": [
        "**/*.md",
        "**/*.mdx",
        "**/.DS_Store",
        "**/.venv/**",
        "**/__pycache__/**",
        "**/*.pyc",
        "**/node_modules/**",
        "**/.mise.local.toml",
        ".claude/**",
        ".artifacts/**",
        "plans/**",
        ".gspot/**",
        "eslint.config.mjs",
        ".markdownlint.jsonc",
        ".editorconfig",
        "prettier.config.mjs",
        ".prettierignore",
        "web/extension.js",
        "web/extension.css",
        "**/bower_components/**",
        "**/venv/**",
        "**/.env",
        "**/.env.*",
        "**/.dev.vars",
        "**/.dev.vars.*",
        "**/bun.lock",
        "**/uv.lock",
        "**/.env*"
    ]
}
