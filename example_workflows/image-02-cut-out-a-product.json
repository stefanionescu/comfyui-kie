                    "widget": {
                        "name": "text"
                    }
                }
            ],
            "outputs": [],
            "properties": {
                "Node name for S&R": "MarkdownNote"
            },
            "widgets_values": [
                "Recraft removes the background and returns a PNG with a clear background. **Image: Generate** gives each image a mask from its transparency. **Get Item From List** takes the image and its mask, and **Join Image with Alpha** puts the transparency back, so the saved PNG keeps a clear background."
            ],
            "title": "Note"
        },
