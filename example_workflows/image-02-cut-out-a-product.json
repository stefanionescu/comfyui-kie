    "nodes": [
        {
            "id": 1,
            "type": "MarkdownNote",
            "pos": [0, 60],
            "size": [400, 120],
            "flags": {},
            "order": 0,
            "mode": 0,
            "inputs": [
                {
                    "name": "text",
